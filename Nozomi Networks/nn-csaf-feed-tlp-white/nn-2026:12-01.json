        {
          "category": "self",
          "summary": "Human-readable advisory.",
          "url": "https://security.nozominetworks.com/NN-2026:12-01"
        }
      ],
      "remediations": [
        {
          "category": "mitigation",
          "details": "Manually edit the \"n2os.conf.user\" file in the Remote Collector and remove the \"!\" prefix from the upstream Guardian or CMC endpoint entry to enable TLS certificate verification.",
          "product_ids": [
            "CSAFPID-0001"
          ]
        },
        {
          "category": "vendor_fix",
          "details": "Upgrade Remote Collector to v26.2.0 or later.",
          "product_ids": [
            "CSAFPID-0001"
          ]
        }
      ],
